APP_ENV_FILE=".env"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
ASSISTANT_TENANT_ID="personal"
ASSISTANT_TIMEZONE="America/Bogota"
ASSISTANT_REPLY_LOCALE="es"
# Default-deny: keep empty to reject every Telegram actor.
TELEGRAM_ALLOWED_USER_IDS=""
PUBLIC_BASE_URL=""

# WhatsApp Cloud API channel. Disabled by default; enabling requires the Meta
# sandbox/production app values below. The egress allowlist derives
# graph.facebook.com and lookaside.fbsbx.com (media download) from the access
# token. Never commit real values (SEC-001).
WHATSAPP_ENABLED="false"
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Default-deny: keep empty to reject every WhatsApp sender. CSV of wa_id
# numbers, e.g. "573001112233,573004445566".
WHATSAPP_ALLOWED_USER_IDS=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Required for every /v1/runtime/*, /admin, and /admin/* request, including
# loopback requests. Use Authorization: Bearer <ADMIN_TOKEN>; no alternate
# header is accepted. Generate/store the value only in ignored local .env.
ADMIN_TOKEN=""
# These fixed server settings are the only local API/admin authority. Request
# identity headers and query parameters cannot override them.
LOCAL_AUTH_PRINCIPAL_ID="local-user"
LOCAL_AUTH_PERMISSION_TIER="P5"

# Persistence. `memory` needs no external dependency. `postgres` requires
# DATABASE_URL, explicit migrations, and the optional postgres package extra.
PERSISTENCE_BACKEND="memory"
DATABASE_URL=""
DATABASE_SCHEMA="public"
# Retention window for `python -m personal_assistant.infrastructure.trace_retention`.
# Production policy: keep traces 30-90 days; pruning is operator-invoked only.
TRACE_RETENTION_DAYS="30"

# Outbound egress allowlist (ADR-004). Comma-separated exact hostnames or
# scheme://hostname entries; no wildcards, subdomains, ports, or paths. Empty
# derives the allowlist from the configured provider base URLs plus
# api.telegram.org when a bot token is set. A non-empty value is an explicit
# override and startup fails closed when it does not cover an enabled
# provider's target host.
EGRESS_ALLOWED_HOSTS=""

# Keep disabled with the default memory backend. Enabling requires PostgreSQL,
# applied migrations, and a non-empty TELEGRAM_BOT_TOKEN.
REMINDER_WORKER_ENABLED="false"
REMINDER_WORKER_INTERVAL_SECONDS="15"
# Must remain greater than the interval when the worker is enabled.
REMINDER_WORKER_HEARTBEAT_TIMEOUT_SECONDS="45"
REMINDER_MINUTES_BEFORE="30"

# Text LLM. Use `minimax` for MiniMax Token Plan / subscription keys.
LLM_PROVIDER="minimax"
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/anthropic"
MINIMAX_MODEL="MiniMax-M3"

# AeroLink or another Anthropic-compatible gateway can still use:
# LLM_PROVIDER="anthropic_compatible"
LLM_API_KEY=""
LLM_BASE_URL="https://aerolink.lat"
LLM_MODEL=""
LLM_AUTH_HEADER="authorization"
LLM_ANTHROPIC_VERSION="2023-06-01"
LLM_TIMEOUT_SECONDS="30"
LLM_MAX_TOKENS="512"
# Provider context window in tokens, used for context-utilization telemetry.
LLM_CONTEXT_WINDOW_TOKENS="200000"
# Anthropic/Claude-Code style aliases are also accepted:
# ANTHROPIC_API_KEY=""
# ANTHROPIC_AUTH_TOKEN=""
# ANTHROPIC_BASE_URL=""
# ANTHROPIC_MODEL=""

# Voice transcription. Groq works with the existing OpenAI-compatible adapter.
TRANSCRIPTION_PROVIDER="disabled"
TRANSCRIPTION_API_KEY=""
GROQ_API_KEY=""
TRANSCRIPTION_BASE_URL="https://api.groq.com/openai"
TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
TRANSCRIPTION_TIMEOUT_SECONDS="60"

# Optional Telegram audio replies through MiniMax TTS. `voice_only` sends audio
# only when the incoming Telegram message was voice/audio; `always` sends it for
# every Telegram reply.
TTS_PROVIDER="disabled"
TTS_API_KEY=""
TTS_BASE_URL="https://api.minimax.io"
TTS_MODEL="speech-2.8-turbo"
TTS_VOICE_ID="male-qn-qingse"
TTS_AUDIO_FORMAT="mp3"
TTS_LANGUAGE_BOOST="Spanish"
TTS_TIMEOUT_SECONDS="30"
TTS_MAX_REPLY_CHARACTERS="280"
TELEGRAM_AUDIO_REPLY_MODE="disabled"
